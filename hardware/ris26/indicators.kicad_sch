	(text "The channel LED brightness is 100% when its channel is chosen, \n75% when its channel is stand by.\n\nRed, unavailable, chosen.\nBlack, unavailable, stand by.\nYellow, valiable, chosen.\nGreen, valiable, stand by."
		(exclude_from_sim no)
